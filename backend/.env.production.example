NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/spandan_clinic
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=24h
ADMIN_SESSION_COOKIE_NAME=admin_session
ADMIN_SESSION_COOKIE_MAX_AGE_MS=86400000
ADMIN_SESSION_COOKIE_SAMESITE=lax
CORS_ORIGIN=https://spandanclinic.com,https://www.spandanclinic.com
FRONTEND_URL=https://spandanclinic.com
RECEIPT_BRAND_NAME=Spandan Super Speciality Clinic
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=
PHONEPE_ENABLED=true
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api.phonepe.com/apis/hermes
