NODE_ENV=development
DEPLOYMENT_ENV=development
ENVIRONMENT_NAME=spandan-development
# Hosted staging/production must set the exact Supabase project reference used by DATABASE_URL.
# Local development may leave this blank while using local PostgreSQL.
SUPABASE_PROJECT_REF=
DATA_POLICY=synthetic-only
PORT=4000
SHUTDOWN_TIMEOUT_MS=25000
METRICS_BEARER_TOKEN=
WORKER_POLL_INTERVAL_MS=1000
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_LEASE_SECONDS=30

# Fail-closed public rollout: disabled -> staff_pilot -> public.
PUBLIC_COMMERCE_MODE=disabled
# Required only in staff_pilot mode; never expose this token in browser bundles.
STAFF_PILOT_TOKEN=

# PostgreSQL
DATABASE_URL=postgresql://spandan:spandan_secret_dev@localhost:5432/spandan_clinic
# Hosted API: Supabase transaction pooler (port 6543). Hosted migrations require the
# separate direct endpoint below (port 5432). Never add sslmode to either URL.
MIGRATION_DATABASE_URL=
DB_SSL_CA=
DB_POOL_MAX=10
DB_WORKER_POOL_MAX=2
DB_MAX_API_REPLICAS=2
DB_MAX_WORKER_REPLICAS=2
DB_ROLLING_SURGE_REPLICAS=1
DB_WORKER_ROLLING_SURGE_REPLICAS=1
DB_MIGRATION_CONNECTION_RESERVE=1
DB_ADMIN_CONNECTION_RESERVE=5
DB_CONNECTION_QUOTA=60
DB_CONNECTION_TARGET_PERCENT=75
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_POOL_TIMEOUT_MS=30000
DB_CONNECTION_MAX_LIFETIME_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=12000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
APPLICATION_REGION=
SUPABASE_REGION=
DB_REGION_RTT_TARGET_MS=100
DB_REGION_RTT_P95_MS=

# JWT
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_SECRET_VERSION=v1
JWT_EXPIRES_IN=24h
ADMIN_SESSION_COOKIE_NAME=admin_session
ADMIN_SESSION_COOKIE_MAX_AGE_MS=28800000
ADMIN_SESSION_IDLE_TIMEOUT_MS=1800000
ADMIN_SESSION_COOKIE_SAMESITE=lax

# Admin seed
ADMIN_EMAIL=admin@spandanclinic.com
ADMIN_PASSWORD=change-this-password

# Email (SMTP)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=staff@spandanclinic.com

# Optional WhatsApp staff notifications
# Set WHATSAPP_WEBHOOK_URL for a simple JSON webhook, or configure provider credentials below.
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM=
WHATSAPP_TO=
WHATSAPP_TIMEOUT_MS=5000

# CORS
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
RECEIPT_BRAND_NAME=Spandan Super Speciality Clinic

# Remote intake (use a separate 32+ byte random secret in production)
INTAKE_ENCRYPTION_KEY=replace-with-a-separate-random-secret-at-least-32-characters
INTAKE_ENCRYPTION_KEY_VERSION=v1
INTAKE_TOKEN_TTL_HOURS=72
# Deletion is disabled until the clinic approves retention; this value is for the future cleanup policy.
INTAKE_DRAFT_RETENTION_DAYS=30
# Short-lived signed-upload broker base URL. Leave blank to keep uploads disabled safely.
INTAKE_UPLOAD_BASE_URL=

# PhonePe
PHONEPE_ENABLED=false
PHONEPE_PILOT_APPROVED=false
# Local/test-only. Production and staging reject mock payments.
PAYMENT_MOCK_ENABLED=false

# Direct UPI remains fail-closed until finance configuration is saved in the admin portal
# and this emergency kill switch is explicitly disabled.
DIRECT_UPI_EMERGENCY_DISABLED=true
DIRECT_UPI_UTR_HMAC_SECRET=
DIRECT_UPI_UTR_ENCRYPTION_KEY=
DIRECT_UPI_UTR_ENCRYPTION_KEY_VERSION=v1
PAYMENT_EVIDENCE_STORAGE_DIR=.private-payment-evidence
PAYMENT_EVIDENCE_ENCRYPTION_KEY=
PAYMENT_EVIDENCE_ENCRYPTION_KEY_VERSION=v1
PAYMENT_EVIDENCE_MAX_BYTES=5242880
PAYMENT_EVIDENCE_RETENTION_DAYS=90
PHONEPE_MERCHANT_ID=
PHONEPE_ENVIRONMENT=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_VERSION=
PHONEPE_CLIENT_SECRET=
PHONEPE_AUTH_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_PG_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_CHECKOUT_EXPIRY_SECONDS=1200
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
# Requires documented clinical, privacy, retention, and authoring-policy approval.
CLINICAL_RECORD_WRITES_ENABLED=false
CLINICAL_OBSERVATIONS_ENABLED=false
# Requires approved device/export formats, retention, staff workflow, and hazard review.
DEVICE_IMPORTS_ENABLED=false

# Requires clinic approval of file types, retention, consent, and reviewer roles.
MEDICAL_DOCUMENTS_ENABLED=false
DOCUMENT_STORAGE_DIR=.private-documents
# Generate a separate high-entropy secret; rotation requires a storage re-encryption runbook.
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_ENCRYPTION_KEY_VERSION=v1
DOCUMENT_MAX_BYTES=10485760
# development permits signature-only testing. Production requires the clamav adapter.
DOCUMENT_SCANNER_MODE=disabled
DOCUMENT_SCANNER_HOST=127.0.0.1
DOCUMENT_SCANNER_PORT=3310
DOCUMENT_SCANNER_TIMEOUT_MS=15000
